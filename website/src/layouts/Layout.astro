---
import { SITE_URL } from '../config/contact';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Engineering Workbench — AI-powered troubleshooting for engineering teams',
  description = 'Investigate across repositories, infrastructure, and tickets with evidence-first AI assistance. Open source. Human-in-the-loop by design.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!import.meta.env.DEV && <base href={`${SITE_URL}/`} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-grid-pattern bg-grid">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
