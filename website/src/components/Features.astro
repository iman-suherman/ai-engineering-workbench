---
const features = [
  {
    title: 'Multi-repo investigation',
    description:
      'Map services to repositories, inspect branches, PRs, and commits across your entire stack in one session.',
    icon: 'repos',
  },
  {
    title: 'Evidence before recommendations',
    description:
      'Every finding is backed by live repository state, infrastructure config, and ticket references — not assumptions.',
    icon: 'evidence',
  },
  {
    title: 'Human-in-the-loop by design',
    description:
      'The agent investigates and drafts. You review evidence, assess risk, and decide what gets communicated.',
    icon: 'human',
  },
  {
    title: 'Structured output',
    description:
      'Consistent Finding / Evidence / Risk / Recommendation format your team can trust and act on quickly.',
    icon: 'output',
  },
  {
    title: 'Communication drafts',
    description:
      'Turn reviewed findings into Chat, Jira, or support replies — ready for you to copy and paste.',
    icon: 'compose',
  },
  {
    title: 'Works with your stack',
    description:
      'Cursor, Copilot, or Codex. Fill the registry from siblings, Terraform, or Helm — optional Jira sync when you need it.',
    icon: 'stack',
  },
];
---

<section id="features" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-label">Features</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Built for how engineering teams actually work
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        Not another chatbot that guesses. A workbench that investigates, consolidates evidence, and keeps humans accountable.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <div class="card group p-6 transition-all hover:border-brand-blue/20 hover:bg-surface-overlay/50">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-blue/10 text-brand-cyan transition-colors group-hover:bg-brand-blue/20">
              {feature.icon === 'repos' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7c-2 0-3 1-3 3z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v4M15 3v4M9 12h6" />
                </svg>
              )}
              {feature.icon === 'evidence' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {feature.icon === 'human' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              )}
              {feature.icon === 'output' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              )}
              {feature.icon === 'compose' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              )}
              {feature.icon === 'stack' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-ink">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
