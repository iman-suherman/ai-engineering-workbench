---
import { TEAM_PLAN } from '../config/team';

const tiers = [
  {
    name: 'Open Source',
    price: 'Free',
    description: 'Self-hosted workbench for your team. Full source code, GPL-3.0 licensed.',
    features: [
      'Service registry & knowledge base',
      'Investigation prompts & workflows',
      'Compose drafts for Chat/Jira',
      'Cursor & Copilot integration',
      'Community support',
    ],
    cta: 'Get started on GitHub',
    ctaHref: 'https://github.com/iman-suherman/ai-engineering-workbench',
    highlighted: false,
  },
  {
    name: TEAM_PLAN.name,
    price: TEAM_PLAN.price,
    priceSuffix: TEAM_PLAN.period,
    priceNote: TEAM_PLAN.billingNote,
    description: TEAM_PLAN.tagline,
    features: [
      'Everything in Open Source',
      'Custom service registry setup',
      'Knowledge base scaffolding',
      '90-min team brown-bag session',
      '2× office hours in month one',
      'Priority email support (1 business day)',
      'Onboarding runbook + 30-day launch support',
    ],
    cta: TEAM_PLAN.cta,
    ctaHref: TEAM_PLAN.ctaHref,
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: 'Contact us',
    description: 'For large organisations with complex multi-repo architectures and compliance needs.',
    features: [
      'Everything in Team',
      'SSO & access controls',
      'Custom integrations',
      'Dedicated success manager',
      'SLA & on-call support',
    ],
    cta: 'Book a demo',
    ctaHref: '/contact?intent=enterprise',
    highlighted: false,
  },
];
---

<section id="pricing" class="border-y border-white/5 bg-surface-raised/40 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-label">Pricing</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Start free. Scale when you're ready.
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        The core workbench is open source forever. Team and Enterprise plans add hands-on setup, onboarding, and priority support.
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <div
            class:list={[
              'card flex flex-col p-8',
              tier.highlighted && 'ring-2 ring-brand-blue/40 shadow-lg shadow-brand-blue/10',
            ]}
          >
            {tier.highlighted && (
              <span class="mb-4 inline-flex w-fit rounded-full bg-brand-gradient px-3 py-1 text-xs font-semibold text-white">
                Most popular
              </span>
            )}
            <h3 class="text-xl font-semibold text-ink">{tier.name}</h3>
            <p class="mt-2 text-3xl font-bold text-ink">
              {tier.price}
              {tier.priceSuffix && (
                <span class="text-base font-medium text-ink-muted"> {tier.priceSuffix}</span>
              )}
            </p>
            <p class="mt-3 text-sm text-ink-muted">{tier.description}</p>
            {tier.priceNote && (
              <p class="mt-2 text-xs text-ink-faint">{tier.priceNote}</p>
            )}

            <ul class="mt-8 flex-1 space-y-3">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-ink-muted">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href={tier.ctaHref}
              class:list={[
                'mt-8 w-full text-center',
                tier.highlighted ? 'btn-primary' : 'btn-secondary',
              ]}
            >
              {tier.cta}
            </a>
            {tier.highlighted && (
              <a href="/team" class="mt-3 block text-center text-xs text-brand-cyan hover:underline">
                View full plan details →
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
