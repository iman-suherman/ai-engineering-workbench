---
const useCases = [
  {
    title: 'Pre-deployment checks',
    description:
      'Before pushing a config change, verify no conflicting development across related services and infrastructure.',
    tag: 'DevOps',
  },
  {
    title: 'Production incidents',
    description:
      'Rapidly trace blast radius across repos, identify recent changes, and assess rollback options with evidence.',
    tag: 'SRE',
  },
  {
    title: 'Cross-team enquiries',
    description:
      'Answer "who owns this?" and "is anyone already working on it?" without Slack archaeology.',
    tag: 'Engineering leads',
  },
  {
    title: 'Security findings',
    description:
      'Investigate vulnerability impact across services, check for existing patches, and draft remediation plans.',
    tag: 'Security',
  },
];
---

<section id="use-cases" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-label">Use cases</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Where teams get the most value
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        Any time an enquiry spans more than one repository, the workbench saves hours of manual context gathering.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {
        useCases.map((useCase) => (
          <div class="card flex flex-col p-8">
            <span class="mb-4 inline-flex w-fit rounded-full bg-brand-blue/10 px-3 py-1 font-mono text-xs text-brand-cyan">
              {useCase.tag}
            </span>
            <h3 class="text-xl font-semibold text-ink">{useCase.title}</h3>
            <p class="mt-3 flex-1 text-ink-muted">{useCase.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
