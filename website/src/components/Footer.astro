---
import Logo from './Logo.astro';
---

<footer class="border-t border-white/5 py-12">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <Logo size="sm" />

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-ink-muted">
        <a href="/#features" class="transition-colors hover:text-ink">Features</a>
        <a href="/#how-it-works" class="transition-colors hover:text-ink">How it works</a>
        <a href="/#pricing" class="transition-colors hover:text-ink">Pricing</a>
        <a href="/team" class="transition-colors hover:text-ink">Team</a>
        <a href="/contact?intent=demo" class="transition-colors hover:text-ink">Contact</a>
        <a
          href="https://github.com/iman-suherman/ai-engineering-workbench"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-ink"
        >
          GitHub
        </a>
      </div>

      <p class="text-sm text-ink-faint">
        GPL-3.0 · <a href="https://suherman.net" class="hover:text-ink">suherman.net</a>
      </p>
    </div>
  </div>
</footer>
