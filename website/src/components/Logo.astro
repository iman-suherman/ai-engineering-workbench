---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

const iconSizes = {
  sm: 'h-8 w-8',
  md: 'h-10 w-10',
  lg: 'h-14 w-14',
};

const textSizes = {
  sm: { top: 'text-[10px]', bottom: 'text-sm' },
  md: { top: 'text-xs', bottom: 'text-lg' },
  lg: { top: 'text-sm', bottom: 'text-2xl md:text-3xl' },
};
---

<div class="flex items-center gap-3">
  <img
    src="/logo.png"
    alt="AI Engineering Workbench"
    width="56"
    height="56"
    decoding="async"
    class:list={[iconSizes[size], 'shrink-0']}
  />
  {
    showText && (
      <div class="flex flex-col leading-tight">
        <span class:list={[textSizes[size].top, 'font-medium tracking-wide text-brand-muted']}>
          AI Engineering
        </span>
        <span class:list={[textSizes[size].bottom, 'font-bold tracking-tight text-brand-heading']}>
          Workbench
        </span>
      </div>
    )
  }
</div>
