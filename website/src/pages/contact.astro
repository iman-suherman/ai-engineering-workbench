---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const intent = Astro.url.searchParams.get('intent') || 'live-demo';
const formType =
  intent === 'enterprise'
    ? 'enterprise'
    : intent === 'support'
      ? 'support'
      : intent === 'demo' || intent === 'live-demo'
        ? 'live-demo'
        : 'live-demo';
const titles = {
  'live-demo': 'Book a live demo',
  demo: 'Book a live demo',
  enterprise: 'Enterprise inquiry',
  support: 'Contact support',
};
const descriptions = {
  'live-demo':
    'Schedule a guided online session (~30–45 min). We walk through the workbench with your repos and use cases.',
  demo: 'Schedule a guided online session (~30–45 min). We walk through the workbench with your repos and use cases.',
  enterprise: 'Tell us about your organisation’s multi-repo architecture, compliance needs, and rollout goals.',
  support: 'Questions about setup, onboarding, or your Team plan? We respond within one business day.',
};
---

<Layout
  title={`${titles[formType]} — AI Engineering Workbench`}
  description={descriptions[formType]}
>
  <Nav />
  <main class="pt-24">
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-6">
        <div class="text-center">
          <p class="section-label">Contact</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink">{titles[formType]}</h1>
          <p class="mt-4 text-lg text-ink-muted">{descriptions[formType]}</p>
        </div>

        <p class="mt-8 rounded-xl border border-brand-cyan/20 bg-brand-cyan/5 px-4 py-3 text-center text-sm text-ink-muted">
          Want to try it yourself first?{' '}
          <a href="/demo" class="font-medium text-brand-cyan hover:underline">Run the self-serve demo</a>
          {' '}(~10 min, no booking).
        </p>

        <div class="mt-8">
          <ContactForm
            formType={formType}
            submitLabel="Request live demo"
            showRole={formType === 'enterprise'}
            showCompany={true}
            showMessage={true}
          />
        </div>

        <p class="mt-6 text-center text-sm text-ink-faint">
          You will receive a confirmation email. We reply within one business day.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
