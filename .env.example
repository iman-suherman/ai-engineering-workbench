# Optional local secrets for workbench helpers (never commit real values).
# Copy to .env and fill only what you use.

# --- Optional: incident sync (npm run sync:incidents) ---
# Provider is chosen on the CLI: --provider jira | servicenow

# Jira / Jira Service Management
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=
# JIRA_JQL=issuetype = Incident AND statusCategory != Done AND priority in ("Highest","High") ORDER BY priority ASC, updated DESC

# ServiceNow
# SERVICENOW_INSTANCE=https://yourinstance.service-now.com
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=
# SERVICENOW_QUERY=active=true^priorityIN1,2^ORDERBYpriority

# --- Optional: GitHub org hint for registry fill / gh ---
# GITHUB_ORG=your-org
